/build/
/out/
/release/
/dist/
*.obj
*.o
*.a
*.lib
*.exp
*.pdb
*.ilk
*.exe
*.dll
*.dylib
*.so

# --- CMake ---
CMakeCache.txt
CMakeFiles/
