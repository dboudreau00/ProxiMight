# Normalize line endings: LF in the repo, native on checkout for scripts.
* text=auto

*.c      text eol=lf
*.h      text eol=lf
*.cpp    text eol=lf
*.rc     text eol=lf
*.cmake  text eol=lf
*.txt    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.ps1    text eol=crlf
*.bat    text eol=crlf

# Binary assets
*.png    binary
*.ico    binary
*.icns   binary
*.ttf    binary
*.otf    binary
